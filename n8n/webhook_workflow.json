{
  "name": "VouchFlow - Webhook test (no Gmail needed)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vouchflow-invoice",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5a1d0f20-0001-4c1b-9a10-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "7d0c2b5e-3f9a-4c1b-8d6e-0a0b0c0d0e01",
      "notes": "Send an invoice file here (multipart form, any field name) to test without Gmail."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0000002-0000-4000-8000-000000000001",
              "name": "api_base_url",
              "value": "http://localhost:8000",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5a1d0f20-0002-4c1b-9a10-000000000002",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300],
      "notes": "EDIT THIS VALUE: the address of your VouchFlow API. No secrets here."
    },
    {
      "parameters": {
        "jsCode": "// One item per PDF/image file that was sent to the webhook.\nconst cfg = $input.first().json;\nconst out = [];\nfor (const req of $('Webhook').all()) {\n  for (const bin of Object.values(req.binary || {})) {\n    const type = String(bin.mimeType || '').toLowerCase();\n    if (type === 'application/pdf' || type.startsWith('image/')) {\n      out.push({\n        json: { api_base_url: cfg.api_base_url, filename: bin.fileName || 'invoice.pdf' },\n        binary: { data: bin },\n      });\n    }\n  }\n}\nif (out.length === 0) {\n  throw new Error('No PDF or image file found. Send it as multipart form data, e.g. curl -F \"file=@invoice.pdf\".');\n}\nreturn out;"
      },
      "id": "5a1d0f20-0003-4c1b-9a10-000000000003",
      "name": "Find the invoice file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base_url }}/api/invoices/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data" }
          ]
        },
        "options": { "timeout": 180000 }
      },
      "id": "5a1d0f20-0004-4c1b-9a10-000000000004",
      "name": "VouchFlow ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "onError": "continueErrorOutput",
      "notes": "Credential: Header Auth with Name X-API-Key and your key as Value. The key is NOT stored in this file.",
      "credentials": { "httpHeaderAuth": { "name": "VouchFlow API key" } }
    },
    {
      "parameters": { "respondWith": "firstIncomingItem", "options": {} },
      "id": "5a1d0f20-0005-4c1b-9a10-000000000005",
      "name": "Answer with the result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 220],
      "notes": "Returns the VouchFlow answer (status, mistakes, recommended action, dashboard link, text)."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: ($json.error ? $json.error.message : 'ingest failed') }) }}",
        "options": { "responseCode": 502 }
      },
      "id": "5a1d0f20-0006-4c1b-9a10-000000000006",
      "name": "Answer with the error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 400],
      "notes": "Wrong key (401), too many calls (429) or a bad file (400) end up here."
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Settings", "type": "main", "index": 0 }]] },
    "Settings": { "main": [[{ "node": "Find the invoice file", "type": "main", "index": 0 }]] },
    "Find the invoice file": { "main": [[{ "node": "VouchFlow ingest", "type": "main", "index": 0 }]] },
    "VouchFlow ingest": {
      "main": [
        [{ "node": "Answer with the result", "type": "main", "index": 0 }],
        [{ "node": "Answer with the error", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": []
}
