# VouchFlow AI - Streamlit secrets example
# For Streamlit Community Cloud: open your app -> Settings -> Secrets and paste your OWN values.
# For local use: copy this file to .streamlit/secrets.toml (that file is git-ignored - never commit it).
#
# Every name below is copied into the environment when the dashboard starts.
# A value left empty (or still containing placeholder text) counts as "not set".

# Your Neon PostgreSQL link, e.g. postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Leave empty to use a temporary SQLite file (fine for a quick demo, data is lost on restart).
DATABASE_URL = ""

# Signs login tokens. REQUIRED when ENVIRONMENT = "production" (at least 32 characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VOUCHFLOW_SECRET_KEY = ""

# Google Gemini key (optional). Without it invoices cannot be read by AI and explanations
# use the plain template; everything else works. Visitors would use YOUR quota if you set it.
GEMINI_API_KEY = ""

# Gemini models (optional)
GEMINI_MODEL = "gemini-3.5-flash-lite"
GEMINI_MODEL_LIST = "gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemini-3-flash-preview"

# Public address of this dashboard (used in the links that alerts contain)
DASHBOARD_URL = "https://YOUR-APP-NAME.streamlit.app"

# "development" or "production". In production the app refuses to start without a real DATABASE_URL
# and VOUCHFLOW_SECRET_KEY, and tells you which one is missing.
ENVIRONMENT = "development"

# Folder for sample and uploaded files
DATA_DIR = "./data"
