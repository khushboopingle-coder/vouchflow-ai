# VouchFlow AI Configuration
# Copy this file to .env and adjust values for your environment.
# In production, never commit real secrets or database URLs to version control.

# Database Connection URL
# For local SQLite (default for development):
DATABASE_URL=sqlite:///./vouchflow.db
# For Neon PostgreSQL (uncomment and replace with your Neon connection string):
# DATABASE_URL=postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Base directory for storing data files (PDFs, contracts, evaluations, uploads)
DATA_DIR=./data

# Environment mode: development, testing, or production
# In production, startup checks require DATABASE_URL (non-SQLite) and VOUCHFLOW_SECRET_KEY.
ENVIRONMENT=development

# Google Gemini AI Configuration (Phase 1 Invoice Reader & Investigation Agent explanations)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Leave it EMPTY to run without AI: invoices cannot be read automatically (they land in "needs review")
# and explanations use the plain template. Everything else works.
GEMINI_API_KEY=

# Primary fallback Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Multi-model fallback list (comma-separated, free-tier rotation)
GEMINI_MODEL_LIST=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemini-3-flash-preview

# Secret key for signing API login tokens (Phase 2). REQUIRED in production (at least 32 characters).
# Leave empty only on your own computer. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
VOUCHFLOW_SECRET_KEY=

# Public address of the dashboard (no trailing slash).
# Used in investigation links returned by the Ingest API for alerts (e.g. Telegram via n8n).
DASHBOARD_URL=http://localhost:8501

# Rate limit for automated invoice ingest (calls per minute per API key on POST /api/invoices/ingest)
INGEST_RATE_LIMIT_PER_MINUTE=20

# 3-Way Matching Tolerance Settings
# Total rounding tolerance in Rupees (differences up to this amount are accepted as valid rounding)
ROUNDING_TOLERANCE_RS=1.00

# Contract Search (RAG) Embeddings Provider
# Options: 'local' (offline ONNX all-MiniLM-L6-v2 via ChromaDB, free, no quota) or 'gemini'
EMBEDDING_PROVIDER=local
